# Generated corpora and reports are never committed (size + licensing).
datasets/
runs/
evaluation/reports/

# Heavy model artifacts are ignored; lightweight JSON sidecars (metadata,
# provenance, and training history) ARE tracked for reproducibility.
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/*.metadata.json
!checkpoints/*.provenance.json
!checkpoints/*.history.json
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors

# Exported full-model weight JSONs are large dev artifacts (reproducible via
# ml.exports.export_tcn_json). The small committed parity fixture under
# src/learnedHarmony/__fixtures__ is what the TS test needs.
exports/*.weights.json

__pycache__/
*.pyc
